<Window x:Class="AleappReader.App.Views.HtmlExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export HTML report" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}">
    <StackPanel Margin="16" Width="400">
        <TextBlock Style="{StaticResource ViewTitle}" Text="HTML report"/>
        <CheckBox x:Name="Transcripts" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Text="Include audio transcripts"/>
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource AccentButton}" Content="Export…" IsDefault="True" Click="Ok_Click"/>
            <Button Style="{StaticResource FlatButton}" Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
